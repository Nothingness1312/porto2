# Set admin username/password env vars for the seed
POSTGRES_USER=kkarinzzz
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=kkarinzzz_portfolio

# Backend
DATABASE_URL=postgresql://kkarinzzz:change_me_to_a_long_random_string@localhost:5432/kkarinzzz_portfolio?schema=public
# Use this inside docker-compose:
# DATABASE_URL_DOCKER=postgresql://kkarinzzz:change_me_to_a_long_random_string@postgres:5432/kkarinzzz_portfolio?schema=public

# --- Supabase (PostgreSQL) ---
# 1. Import database/schema.sql via Supabase Dashboard -> SQL Editor
# 2. Connection string Settings -> Database -> Connect -> "Session pooler" (paling aman utk Prisma)
#    Format: postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# 3. Masuk .env, lalu seed + start:
#    bun install && bun run generate && bun run seed && bun run build && bun run start
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# DATABASE_URL_DIRECT=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
JWT_SECRET=change_me_to_a_long_random_string_32_chars_min
NODE_ENV=development
PORT=4000

# Frontend
VITE_API_URL=http://localhost:4000/api

# In production docker, BACKEND_URL inside container points to backend:4000
BACKEND_URL=http://localhost:4000/api
PUBLIC_API_URL=http://localhost:3000/api

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Admin — required, at least 8 characters (seed fails otherwise)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# --- Frontend (Vercel + Supabase) ---
# frontend-v2 talks DIRECTLY to Supabase (supabase-js). No Express backend.
# Import in this order via Supabase Dashboard -> SQL Editor:
#   1. database/schema.sql
#   2. database/rls.sql
#   3. database/seed-data.sql
# Create the admin via Authentication -> Users -> Add user, then set
# App metadata -> { "role": "admin" } (see rls.sql header).
#
# Project Settings -> API:  Project URL + anon public key.
# Set both in frontend-v2/.env.local for local dev, and as the SAME names
# under Vercel -> Project -> Settings -> Environment Variables (build-time):
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<your_anon_public_key>